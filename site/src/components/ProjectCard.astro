---
import { Image } from 'astro:assets';
import { ArrowUpRight, Star } from 'lucide-react';

import GithubIcon from '@/components/GithubIcon.astro';
import { Badge } from '@/components/ui/badge';
import { buttonVariants } from '@/components/ui/button';
import { Card } from '@/components/ui/card';
import type { Project } from '@/data/projects';
import { ui, type Locale } from '@/i18n';
import { getStars } from '@/lib/github';
import { cn } from '@/lib/utils';

interface Props {
  project: Project;
  locale: Locale;
  index: number;
}

const { project, locale, index } = Astro.props;
const t = ui[locale];
const stars = await getStars(project.repo);
const repoUrl = `https://github.com/${project.repo}`;
const flipped = index % 2 === 1;
// Alternate a slight tilt so the stack reads as pinned-up paper rather than a grid.
const tilt = ['lg:-rotate-1', 'lg:rotate-[0.8deg]', 'lg:-rotate-[0.6deg]', 'lg:rotate-1'][index % 4];
const headingId = `project-${project.slug}`;
---

<article aria-labelledby={headingId} class={cn('transition-transform duration-300 hover:rotate-0', tilt)}>
  <Card className="gap-0 overflow-hidden bg-secondary-background py-0 shadow-big">
    <div class={cn('grid lg:grid-cols-[1.15fr_1fr]', flipped && 'lg:[&>*:first-child]:order-2')}>
      <div
        class={cn(
          'relative flex items-center justify-center overflow-hidden border-b-2 border-border p-5 sm:p-8 lg:border-b-0',
          flipped ? 'lg:border-l-2' : 'lg:border-r-2',
        )}
        style={`background-color:${project.accent}`}
      >
        <span
          class="absolute top-3 left-4 font-heading text-6xl leading-none text-black/15 select-none sm:text-8xl"
          aria-hidden="true"
        >
          {String(index + 1).padStart(2, '0')}
        </span>
        {
          project.visual.kind === 'image' ? (
            <Image
              src={project.visual.src}
              alt={project.visual.alt[locale]}
              widths={[480, 800, 1200]}
              sizes="(min-width: 1024px) 600px, 100vw"
              class="relative w-full border-2 border-border bg-white shadow-shadow"
              loading={index === 0 ? 'eager' : 'lazy'}
            />
          ) : (
            <pre class="relative w-full overflow-x-auto border-2 border-border bg-black p-4 font-mono text-xs leading-relaxed text-[#9be15d] shadow-shadow sm:text-sm">
              {project.visual.lines.map((line) => (
                <span class:list={['block', { 'text-white/55': line.startsWith('#') }]}>{line}</span>
              ))}
            </pre>
          )
        }
      </div>

      <div class="flex flex-col gap-5 p-6 sm:p-8">
        <div class="flex flex-wrap items-start justify-between gap-3">
          <h3 id={headingId} class="font-heading text-3xl break-words sm:text-4xl">{project.name}</h3>
          {
            stars !== null && (
              <Badge className="gap-1.5 bg-main px-2 py-1 text-sm font-heading">
                <Star className="size-3.5! fill-current" aria-hidden="true" />
                <span>
                  {stars.toLocaleString(locale)}
                  <span class="sr-only"> {t.projects.stars}</span>
                </span>
              </Badge>
            )
          }
        </div>

        <p class="text-lg leading-snug font-semibold">{project.tagline[locale]}</p>
        <p class="leading-relaxed">{project.summary[locale]}</p>

        <ul class="grid gap-2 text-sm leading-relaxed">
          {
            project.highlights[locale].map((item) => (
              <li class="flex gap-2.5">
                <span class="mt-1.5 size-2.5 shrink-0 border-2 border-border bg-main" aria-hidden="true" />
                <span>{item}</span>
              </li>
            ))
          }
        </ul>

        <ul class="flex flex-wrap gap-2" aria-label={t.projects.tech}>
          {
            project.tech.map((tech) => (
              <li>
                <Badge variant="neutral">{tech}</Badge>
              </li>
            ))
          }
        </ul>

        <div class="mt-auto flex flex-wrap gap-3 pt-2">
          {
            project.url ? (
              <>
                <a href={project.url} class={buttonVariants()} style={`background-color:${project.accent}`}>
                  {t.projects.visit}
                  <ArrowUpRight aria-hidden="true" />
                </a>
                <a href={repoUrl} class={buttonVariants({ variant: 'neutral' })}>
                  <GithubIcon class="size-4" />
                  {t.projects.source}
                </a>
              </>
            ) : (
              <a href={repoUrl} class={buttonVariants()} style={`background-color:${project.accent}`}>
                <GithubIcon class="size-4" />
                {t.projects.github}
                <ArrowUpRight aria-hidden="true" />
              </a>
            )
          }
        </div>
      </div>
    </div>
  </Card>
</article>
