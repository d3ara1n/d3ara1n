---
import { profile, ui, type Locale } from '@/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = ui[locale];
const year = new Date().getFullYear();
---

<footer class="pass-through mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-3 px-4 pb-10 sm:px-6">
  <p class="border-2 border-border bg-secondary-background px-3 py-1.5 text-sm shadow-shadow">
    © {year} {profile.name}
  </p>
  <p class="border-2 border-border bg-secondary-background px-3 py-1.5 text-sm shadow-shadow">{t.footer}</p>
</footer>
